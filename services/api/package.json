{
  "name": "@dotwatch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "seed": "tsx src/scripts/seed.ts",
    "simulate": "tsx src/scripts/simulate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@dotwatch/shared": "0.1.0",
    "express": "4.21.2",
    "firebase-admin": "12.7.0",
    "pg": "8.13.1",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.1",
    "@types/pg": "8.11.10",
    "@types/ws": "8.5.13",
    "esbuild": "0.24.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
