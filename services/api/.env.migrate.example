# Copy to .env.migrate (never commit it) and fill in all four. docs/MIGRATION.md explains where each comes from.

# Old system: Render → the old PostgreSQL database → Connect → External → External Database URL
LEGACY_DATABASE_URL=
# Old system: Render → old backend → Environment → DEVICE_SECRET_ENCRYPTION_KEY
LEGACY_SECRET_KEY=

# New system (production): the same two values as Render → dotwatch-api → Environment
DATABASE_URL=
DEVICE_SECRET_PEPPER=
