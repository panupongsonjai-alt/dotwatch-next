# Local development (docker compose up -d db)
DATABASE_URL=postgres://dotwatch:dotwatch@localhost:5432/dotwatch
PORT=4000
NODE_ENV=development

# dev = accept "Bearer dev:<uid>" or "dev:<uid>:<email>" tokens (refused when NODE_ENV=production)
# firebase = verify Firebase ID tokens
AUTH_MODE=dev
FIREBASE_PROJECT_ID=

# Any long random string. Changing it invalidates every device secret.
DEVICE_SECRET_PEPPER=local-dev-pepper-change-me

CORS_ORIGIN=http://localhost:5173

DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# production only: refuse to migrate without TimescaleDB (Tiger Cloud)
REQUIRE_TIMESCALE=false

# Tests use their own database; the name must contain "test".
TEST_DATABASE_URL=postgres://dotwatch:dotwatch@localhost:5432/dotwatch_test

# Notifications (batch 2). Leave keys empty to dry-run: messages are printed in the API log.
APP_URL=http://localhost:5173
APP_TIMEZONE=Asia/Bangkok
# LINE Developers console → your Messaging API channel → "Channel access token (long-lived)" and "Channel secret"
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# resend.com → API Keys. EMAIL_FROM must use a domain verified in Resend, e.g. dotWatch <alerts@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=
NOTIFY_INTERVAL_MS=5000

# Import from the old system (batch 4, docs/MIGRATION.md). Read-only access is enough.
LEGACY_DATABASE_URL=
# The old system's DEVICE_SECRET_ENCRYPTION_KEY: with it, boards keep their current secrets.
LEGACY_SECRET_KEY=
