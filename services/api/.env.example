# Local development (docker compose up -d db)
DATABASE_URL=postgres://dotwatch:dotwatch@localhost:5432/dotwatch
PORT=4000
NODE_ENV=development

# dev = accept "Bearer dev:<uid>" tokens (refused when NODE_ENV=production)
# firebase = verify Firebase ID tokens
AUTH_MODE=dev
FIREBASE_PROJECT_ID=

# Any long random string. Changing it invalidates every device secret.
DEVICE_SECRET_PEPPER=local-dev-pepper-change-me

CORS_ORIGIN=http://localhost:5173

DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# production only: refuse to migrate without TimescaleDB (Tiger Cloud)
REQUIRE_TIMESCALE=false

# Tests use their own database; the name must contain "test".
TEST_DATABASE_URL=postgres://dotwatch:dotwatch@localhost:5432/dotwatch_test
